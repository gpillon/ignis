# build artifacts
target/
kernel/build/
kernel/build-a/
kernel/build-b/
kernel/build-c/
kernel/build-119/

# the Playground frontend (web/, ADR 0026): dependencies, build output and
# the vitest reporter's JSON run record
node_modules/
dist/
.vitest/

# logs
*.log
*.log.err
_bench_logs/

# python
__pycache__/
*.pyc

# local agent state
.qwen/
.claude/
.codex/

# per-machine Makefile overrides (template: local.mk.example)
local.mk

# the scratchpad: temporary artifacts, experiments, raw logs, workflow output
# and the server pid/logs from `make start`. Local to each clone; durable
# material belongs in docs/ (see docs/agents/issue-tracker.md).
.scratch/

# local artifact store (junction/symlink to the .ninfer artifact dir, never committed)
models/

# recorded G4 load traces (real working-session content, GitHub #118) — only
# the SHA-256 + shape summary (*.meta.json) is committed, never the trace.
# Every trace file lives here as *.jsonl regardless of name (a narrower
# "*-trace.jsonl" pattern missed "...-real-client.jsonl" once — broadened
# on purpose, never narrow this back).
bench/traces/*.jsonl

# profiler captures (GitHub #220's push was blocked by one): an Nsight Systems
# capture records the profiled process's environment, so it carries whatever
# API keys were set when the run started. The command and the derived report
# are the committable evidence; the capture itself stays on disk.
*.nsys-rep
*.nsys-rep.sqlite
*.qdrep
