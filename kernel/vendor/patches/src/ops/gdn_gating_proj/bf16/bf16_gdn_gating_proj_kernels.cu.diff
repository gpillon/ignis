+// Ignis portability patch (ADR 0077, GitHub #478): CTAs/SM of one kernel launch_bf16_prefill_mma
+// launches, configured as it configures it. Its template arguments take the launch's defaults, so
+// a call reads like the launch it budgets; it names only instantiations the launches already make.
+template <class Geometry, int SplitK, int Warps, bool NormalizeInput, int NormTokenCapacity,
+          bool FullTokens>
+int prefill_mma_variant_ctas_per_sm() {
+    constexpr int kSmemBytes = kBf16GdnSmemBytes<Geometry::kBlockN>;
+    const auto kernel = bf16_gdn_gating_proj_gemm_mma_kernel<Geometry, SplitK, FullTokens, Warps,
+                                                             NormalizeInput, NormTokenCapacity>;
+    CUDA_CHECK(
+        cudaFuncSetAttribute(kernel, cudaFuncAttributeMaxDynamicSharedMemorySize, kSmemBytes));
+    int ctas = 0;
+    CUDA_CHECK(cudaOccupancyMaxActiveBlocksPerMultiprocessor(&ctas, kernel, Warps * 32, kSmemBytes));
+    return ctas;
+}
+
+template <class Geometry, int SplitK, int Warps = kBf16GdnWarps, bool NormalizeInput = false,
+          int NormTokenCapacity = 0>
+int prefill_mma_ctas_per_sm() {
+    return std::min(
+        prefill_mma_variant_ctas_per_sm<Geometry, SplitK, Warps, NormalizeInput, NormTokenCapacity,
+                                        true>(),
+        prefill_mma_variant_ctas_per_sm<Geometry, SplitK, Warps, NormalizeInput, NormTokenCapacity,
+                                        false>());
+}
+
 } // namespace
 
 void bf16_gdn_gating_proj_gemv_launch(const Tensor& x, const Weight& a_weight,
