+// Ignis portability patch (ADR 0077, GitHub #478): each case names the kernel its launch above
+// runs, with the same template arguments.
+int bf16_gdn_gating_cooperative_ctas_per_sm(Bf16GdnGatingCooperativeKernel kernel) {
+    switch (kernel) {
+    case Bf16GdnGatingCooperativeKernel::Mma27Split8:
+        return prefill_mma_ctas_per_sm<Bf16Gdn27Geometry, 8, 8>();
+    case Bf16GdnGatingCooperativeKernel::Mma27Split4:
+        return prefill_mma_ctas_per_sm<Bf16Gdn27Geometry, 4>();
+    case Bf16GdnGatingCooperativeKernel::Mma27Split2:
+        return prefill_mma_ctas_per_sm<Bf16Gdn27Geometry, 2>();
+    case Bf16GdnGatingCooperativeKernel::Norm27Split40:
+        return std::min(prefill_mma_ctas_per_sm<Bf16Gdn27Geometry, 40, 8, true, 6>(),
+                        prefill_mma_ctas_per_sm<Bf16Gdn27Geometry, 40, 8, true, 8>());
+    case Bf16GdnGatingCooperativeKernel::Mma35Split32:
+        return prefill_mma_ctas_per_sm<Bf16Gdn35Geometry, 32, 8>();
+    case Bf16GdnGatingCooperativeKernel::Norm35Split32:
+        return std::min({prefill_mma_ctas_per_sm<Bf16Gdn35Geometry, 32, 8, true, 6>(),
+                         prefill_mma_ctas_per_sm<Bf16Gdn35Geometry, 32, 8, true, 8>(),
+                         prefill_mma_ctas_per_sm<Bf16Gdn35Geometry, 32, 8, true, 12>(),
+                         prefill_mma_ctas_per_sm<Bf16Gdn35Geometry, 32, 8, true, 16>()});
+    case Bf16GdnGatingCooperativeKernel::Mma35Split16:
+        return prefill_mma_ctas_per_sm<Bf16Gdn35Geometry, 16, 8>();
+    case Bf16GdnGatingCooperativeKernel::Mma35Split8:
+        return prefill_mma_ctas_per_sm<Bf16Gdn35Geometry, 8, 8>();
+    case Bf16GdnGatingCooperativeKernel::Mma35Split4:
+        return prefill_mma_ctas_per_sm<Bf16Gdn35Geometry, 4, 8>();
+    case Bf16GdnGatingCooperativeKernel::Mma35Split2:
+        return prefill_mma_ctas_per_sm<Bf16Gdn35Geometry, 2, 8>();
+    }
+    throw std::logic_error("BF16 GDN gating: unknown cooperative kernel");
+}
