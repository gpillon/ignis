# The vendored reference subtree is content-addressed: kernel/vendor/manifest.json
# records each file's SHA-256, and scripts/vendor-ninfer.ps1 verifies it. Any
# end-of-line normalization on checkout or commit would change those bytes and
# break the byte-identical guarantee of ADR 0010, so git must leave them alone.
kernel/vendor/** -text

# The Makefile and its includes run under a POSIX sh on every OS: keep them LF.
Makefile text eol=lf
*.mk text eol=lf

# Shell scripts are executed by bash on Linux (kernel/build.sh, mk/linux/*.sh,
# the Containerfile's build stage). A CRLF checkout on a Windows worktree that
# is then copied into a container dies with a CR in every command name.
*.sh text eol=lf

# Text fixtures a test compares byte for byte (expert_residency_fixture.rs
# reads trace_v1.txt and compares it with the policy model's LF output): a
# CRLF checkout on a Windows runner (core.autocrlf=true) breaks the equality.
kernel/tests/fixtures/residency/*.txt text eol=lf
# The same for Flash-Next's logits capture (flash_next_rope_logits_gpu.rs),
# whose SHA-256 its provenance records (hq_kv_fixture_integrity.rs).
crates/core/tests/fixtures/flash_next/*.txt text eol=lf
# The code span the trellis program is compared on (trellis_logits_gpu.rs): its
# tokens are the measured top-1 agreement's positions.
crates/core/tests/fixtures/trellis_logits/*.txt text eol=lf
# The code span the span logits are checked on (span_logits_gpu.rs): its tokens
# are the measured KL bounds' positions.
crates/core/tests/fixtures/span_logits/*.txt text eol=lf

# The operator catalog the alias tests split and edit at line ends
# (download/catalog.rs: the line `models:`, the line `card_class: 16`): a
# CRLF checkout on a Windows runner leaves the split nothing to find and the
# edit nothing to remove, so a test would check a catalog it never built.
crates/server/tests/fixtures/catalog/*.yaml text eol=lf

# The image converter's committed work tree (crates/artifact/tests/qwen_image.rs): each
# unit's DONE pins the sha256 of its JSON files, so a CRLF checkout would break the pack.
crates/artifact/tests/fixtures/qwen_image_work/** -text

# The speech oracle's fixtures (crates/speech/tests): f32 tensors and the FLEURS clip, read byte
# for byte by front_end.rs and oracle.rs.
crates/speech/tests/fixtures/oracle/**/*.bin -text
crates/speech/tests/fixtures/oracle/*.wav -text
# server_vad's: the VAD's weights, built into the binary, and its oracle's probabilities (vad.rs).
crates/speech/vad/*.safetensors -text
crates/speech/tests/fixtures/vad/*.bin -text

# Audio fixtures are binary: no end-of-line conversion.
crates/server/tests/fixtures/audio/*.wav binary
crates/server/tests/fixtures/audio/*.flac binary
crates/server/tests/fixtures/audio/*.mp3 binary
crates/server/tests/fixtures/audio/*.aac binary
crates/server/tests/fixtures/audio/*.m4a binary
crates/server/tests/fixtures/audio/*.ogg binary
crates/server/tests/fixtures/audio/*.mka binary
crates/server/tests/fixtures/audio/*.webm binary
