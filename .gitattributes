# The vendored reference subtree is content-addressed: kernel/vendor/manifest.json
# records each file's SHA-256, and scripts/vendor-ninfer.ps1 verifies it. Any
# end-of-line normalization on checkout or commit would change those bytes and
# break the byte-identical guarantee of ADR 0010, so git must leave them alone.
kernel/vendor/** -text

# The Makefile and its includes run under a POSIX sh on every OS: keep them LF.
Makefile text eol=lf
*.mk text eol=lf

# Shell scripts are executed by bash on Linux (kernel/build.sh, mk/linux/*.sh,
# the Containerfile's build stage). A CRLF checkout on a Windows worktree that
# is then copied into a container dies with a CR in every command name.
*.sh text eol=lf
