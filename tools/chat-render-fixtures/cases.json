[
  {"name": "tool_call_key_order", "tools": [
    {"type": "function", "function": {"name": "edit", "description": "Edit <file> & report it's diff",
      "parameters": {"type": "object", "properties": {"path": {"type": "string"}}, "required": ["path"]}}}],
   "messages": [
    {"role": "user", "content": "Rename x to y in src/b.rs."},
    {"role": "assistant", "content": "", "tool_calls": [
      {"id": "call_0", "name": "edit",
       "arguments": "{\"path\": \"src/b.rs\", \"dry_run\": false, \"edits\": [{\"old\": \"x\", \"new\": \"y\"}], \"count\": 2, \"note\": \"a > b & 'c'\"}"}]},
    {"role": "tool", "tool_call_id": "call_0", "content": "2 edits applied"}]},

  {"name": "tool_call_reversed_keys", "messages": [
    {"role": "user", "content": "Again, other way round."},
    {"role": "assistant", "content": "", "tool_calls": [
      {"id": "call_1", "name": "edit",
       "arguments": "{\"note\": \"a > b & 'c'\", \"count\": 2, \"edits\": [{\"new\": \"y\", \"old\": \"x\"}], \"dry_run\": false, \"path\": \"src/b.rs\"}"}]},
    {"role": "tool", "tool_call_id": "call_1", "content": "2 edits applied"}]},

  {"name": "tool_call_two_calls", "messages": [
    {"role": "user", "content": "Read both files."},
    {"role": "assistant", "content": "Reading them now.", "tool_calls": [
      {"id": "call_0", "name": "read_file", "arguments": "{\"path\": \"b.rs\", \"limit\": 40}"},
      {"id": "call_1", "name": "read_file", "arguments": "{\"limit\": 40, \"path\": \"a.rs\"}"}]},
    {"role": "tool", "tool_call_id": "call_0", "content": "fn main() {}"}]},

  {"name": "tool_call_empty_arguments", "messages": [
    {"role": "user", "content": "What time is it?"},
    {"role": "assistant", "content": "", "tool_calls": [
      {"id": "call_0", "name": "now", "arguments": "{}"}]},
    {"role": "tool", "tool_call_id": "call_0", "content": "12:00"}]},

  {"name": "plain_chat", "messages": [
    {"role": "system", "content": "You are a careful assistant."},
    {"role": "user", "content": "Hello."},
    {"role": "assistant", "content": "Hi there."},
    {"role": "user", "content": "And again."}]}
]
